{
  "name": "bayanihan",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=22.22.2 <23"
  },
  "scripts": {
    "dev": "concurrently --kill-others --names api,web \"npm run dev --workspace @bayanihan/api\" \"npm run dev --workspace @bayanihan/web\"",
    "dev:api": "npm run dev --workspace @bayanihan/api",
    "dev:web": "npm run dev --workspace @bayanihan/web",
    "typecheck": "npm run typecheck --workspaces",
    "build": "npm run build --workspaces",
    "test": "npm run test --workspace @bayanihan/api",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "concurrently": "9.2.5",
    "typescript": "5.9.3"
  }
}
