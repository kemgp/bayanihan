{
  "name": "bayanihan",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=22.22.2 <23"
  },
  "scripts": {
    "dev": "concurrently --kill-others --names api,web \"npm run dev --workspace @bayanihan/api\" \"npm run dev --workspace @bayanihan/web\"",
    "dev:api": "npm run dev --workspace @bayanihan/api",
    "dev:web": "npm run dev --workspace @bayanihan/web",
    "typecheck": "npm run typecheck --workspaces",
    "build": "npm run build --workspaces",
    "test": "npm run test:web && npm run test --workspace @bayanihan/api",
    "test:web": "TSX_TSCONFIG_PATH=apps/web/tsconfig.json node --import tsx --test apps/web/src/lib/api.test.ts apps/web/src/screens/*.test.tsx",
    "test:db": "node scripts/test-db.mjs",
    "check": "npm run typecheck && npm test && npm run test:db && npm run build"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.11",
    "concurrently": "9.2.5",
    "typescript": "5.9.3"
  }
}
