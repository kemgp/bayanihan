  },
  "dependencies": {
    "@paiflow/sdk": "0.2.0",
    "@stellar/stellar-sdk": "17.3.0",
    "@supabase/supabase-js": "2.118.0",
    "cors": "2.8.5",
    "dotenv": "16.6.1",
    "express": "5.3.0",
    "helmet": "8.1.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/supertest": "^6.0.0",
    "supertest": "7.1.4",
    "tsx": "4.20.6"
  }
}
